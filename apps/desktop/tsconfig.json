{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/lib/clickEngine": ["./src/native/clickEngine.ts"],
      "@/lib/metronome": ["./src/native/metronome.ts"],
      "@/lib/audioInput": ["./src/native/audioInput.ts"],
      "@/lib/recorderEngine": ["./src/native/recorderEngine.ts"],
      "@/lib/padInput": ["./src/native/padInput.ts"],
      "@/*": ["../web/*"],
      "@web/*": ["../web/*"],
      "convex-auth-react-original": ["../web/node_modules/@convex-dev/auth/dist/react/index.d.ts"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "next/dynamic": ["./src/shims/next-dynamic.tsx"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/font/google": ["./src/shims/next-font-google.ts"],
      "next/font/local": ["./src/shims/next-font-local.ts"],
      "@jam-practice/convex/*": ["../../packages/convex/*"],
      "@jam-practice/core/*": ["../../packages/core/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/core/types/**/*.d.ts"]
}
