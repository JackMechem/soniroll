# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# No leading slashes on the path-specific entries below (apart from this file's own repo-root
# anchoring, which no longer applies) — this is now a pnpm monorepo root, so these need to match
# node_modules/.next/etc. at any depth (apps/web/node_modules, apps/mobile/.expo, ...), not just
# at the literal repo root the way a single-package repo's .gitignore did before the Expo
# migration's restructure.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# expo / react native (apps/mobile, once scaffolded)
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri desktop app (apps/desktop)
apps/desktop/dist/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/
