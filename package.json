{
  "name": "jam-practice-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @jam-practice/web dev",
    "build": "pnpm --filter @jam-practice/web build",
    "lint": "pnpm --filter @jam-practice/web lint",
    "convex:dev": "pnpm --filter @jam-practice/convex dev",
    "convex:deploy": "pnpm --filter @jam-practice/convex deploy",
    "mobile": "pnpm --filter @jam-practice/mobile start",
    "desktop": "pnpm --filter @jam-practice/desktop dev",
    "desktop:build": "pnpm --filter @jam-practice/desktop build"
  }
}
